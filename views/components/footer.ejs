<style>
.og-footer {
    margin-top: 48px;
    border-top: 1px solid rgba(255,255,255,0.05);
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}
.og-footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: rgba(150,135,200,0.45);
}
.og-footer-brand span { color: rgba(167,139,250,0.6); font-weight: 500; }
.og-footer-links { display: flex; gap: 14px; }
.og-footer-links a {
    font-size: 12px;
    color: rgba(150,135,200,0.4);
    text-decoration: none;
    transition: color 0.15s;
}
.og-footer-links a:hover { color: rgba(167,139,250,0.8); }
</style>

<footer class="og-footer">
    <div class="og-footer-brand">
        <span><%= settings && settings.panelName ? settings.panelName : 'OgUltra Panel' %></span>
        &copy; <%= new Date().getFullYear() %> — All Rights Reserved
    </div>
    <div class="og-footer-links">
        <a href="https://github.com/ogactyl" target="_blank"><i class="fab fa-github"></i> GitHub</a>
        <a href="https://discord.gg/aEVDpwnMKn" target="_blank"><i class="fab fa-discord"></i> Discord</a>
    </div>
</footer>
