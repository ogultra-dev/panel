<%- include('../../components/admin_template') %>

<style>
.ap-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; padding: 24px; }
.ap-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.2s;
}
.ap-card:hover { border-color: rgba(139,92,246,0.2); }
.ap-card-head {
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255,255,255,0.02);
}
.ap-card-head svg { color: #8b5cf6; flex-shrink: 0; }
.ap-card-title { font-size: 14px; font-weight: 600; color: #fff; }
.ap-card-body { padding: 20px; display: flex; flex-direction: column; gap: 18px; }

.ap-label { font-size: 12px; font-weight: 500; color: rgba(180,165,230,0.7); margin-bottom: 7px; display: block; letter-spacing: 0.03em; }
.ap-desc  { font-size: 11.5px; color: rgba(150,135,200,0.45); margin-top: 4px; }

.ap-input-row { display: flex; gap: 8px; }
.ap-input-row input { flex: 1; }

/* Upload zone */
.ap-upload-zone {
    border: 1.5px dashed rgba(139,92,246,0.25);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all 0.2s;
    background: rgba(109,40,217,0.04);
    position: relative;
}
.ap-upload-zone:hover {
    border-color: rgba(139,92,246,0.5);
    background: rgba(109,40,217,0.08);
}
.ap-upload-zone input[type="file"] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
}
.ap-upload-icon {
    width: 40px; height: 40px;
    background: rgba(109,40,217,0.15);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    color: #8b5cf6;
}
.ap-upload-text { font-size: 13px; font-weight: 500; color: rgba(200,185,255,0.8); text-align: center; }
.ap-upload-hint { font-size: 11.5px; color: rgba(150,135,200,0.45); text-align: center; }

/* Preview box */
.ap-preview {
    display: none;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 10px;
    padding: 12px;
    align-items: center;
    gap: 12px;
}
.ap-preview.show { display: flex; }
.ap-preview img { height: 40px; width: auto; border-radius: 6px; object-fit: contain; }
.ap-preview-name { font-size: 12px; color: rgba(180,165,230,0.7); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Toggle */
.ap-toggle-row {
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 10px;
    padding: 13px 16px;
}
.ap-toggle-info { flex: 1; }
.ap-toggle-label { font-size: 13px; font-weight: 500; color: rgba(220,210,255,0.85); }
.ap-toggle-sub   { font-size: 11.5px; color: rgba(150,135,200,0.45); margin-top: 2px; }
.ap-switch {
    position: relative; width: 40px; height: 22px; flex-shrink: 0;
}
.ap-switch input { opacity: 0; width: 0; height: 0; }
.ap-switch-track {
    position: absolute; cursor: pointer; inset: 0;
    background: rgba(255,255,255,0.1);
    border-radius: 22px;
    transition: 0.2s;
    border: 1px solid rgba(255,255,255,0.08);
}
.ap-switch input:checked + .ap-switch-track { background: #7c3aed; border-color: #8b5cf6; }
.ap-switch-track::after {
    content: '';
    position: absolute;
    left: 3px; top: 3px;
    width: 14px; height: 14px;
    background: #fff;
    border-radius: 50%;
    transition: 0.2s;
}
.ap-switch input:checked + .ap-switch-track::after { transform: translateX(18px); }

/* Page header */
.ap-page-head {
    padding: 24px 24px 0;
    margin-bottom: 4px;
}
.ap-page-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 20px; font-weight: 600; color: #fff;
    display: flex; align-items: center; gap: 10px;
}
.ap-page-sub { font-size: 13px; color: rgba(150,135,200,0.5); margin-top: 4px; }

/* Current asset preview strip */
.ap-current {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    background: rgba(16,185,129,0.06);
    border: 1px solid rgba(16,185,129,0.15);
    border-radius: 10px;
    font-size: 12px;
    color: #6ee7b7;
}
.ap-current img { height: 28px; width: auto; border-radius: 5px; object-fit: contain; }
</style>

<main>
    <div class="ap-page-head">
        <div class="ap-page-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
            </svg>
            Appearance
        </div>
        <div class="ap-page-sub">Customize panel branding, logo, favicon and registration settings</div>
    </div>

    <%- include('../../components/settings') %>

    <div class="ap-grid">

        <!-- ── Panel Name ── -->
        <div class="ap-card">
            <div class="ap-card-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
                <span class="ap-card-title">Panel Name</span>
            </div>
            <div class="ap-card-body">
                <div>
                    <label class="ap-label">Display Name</label>
                    <form action="/admin/settings/change/name" method="POST">
                        <div class="ap-input-row">
                            <input type="text" name="name" value="<%= name %>" maxlength="32" placeholder="OgUltra Panel" required>
                            <button type="submit" class="btn btn-primary" style="white-space:nowrap;padding:8px 16px;">Save</button>
                        </div>
                    </form>
                    <p class="ap-desc">Shown in the navbar and browser tab. Max 32 chars.</p>
                </div>
            </div>
        </div>

        <!-- ── Panel Logo ── -->
        <div class="ap-card">
            <div class="ap-card-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span class="ap-card-title">Panel Logo</span>
            </div>
            <div class="ap-card-body">
                <% if (logo == true) { %>
                <div class="ap-current">
                    <img src="/assets/logo.png?t=<%= Date.now() %>" alt="Current logo">
                    <span style="flex:1">Current logo active</span>
                    <form action="/admin/settings/change/logo" method="POST" style="margin:0">
                        <input type="hidden" name="type" value="none">
                        <button type="submit" class="btn btn-danger" style="padding:4px 10px;font-size:12px;">Remove</button>
                    </form>
                </div>
                <% } %>

                <form action="/admin/settings/change/logo" method="POST" enctype="multipart/form-data" id="logoForm">
                    <input type="hidden" name="type" value="image">
                    <label class="ap-upload-zone" id="logoZone">
                        <input type="file" name="logo" accept="image/png,image/jpeg,image/svg+xml,image/webp" onchange="previewFile(this,'logoPreview','logoZone')">
                        <div class="ap-upload-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        </div>
                        <div class="ap-upload-text">Click to upload logo</div>
                        <div class="ap-upload-hint">PNG, JPG, SVG, WEBP — shown in navbar icon</div>
                    </label>
                    <div class="ap-preview" id="logoPreview">
                        <img src="" alt="preview" id="logoPreviewImg">
                        <span class="ap-preview-name" id="logoPreviewName"></span>
                    </div>
                    <button type="submit" class="btn btn-primary" id="logoSubmit" style="width:100%;justify-content:center;display:none;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Upload Logo
                    </button>
                </form>
                <p class="ap-desc">Logo appears as the icon in the navbar. Recommended: 64×64px square.</p>
            </div>
        </div>

        <!-- ── Favicon ── -->
        <div class="ap-card">
            <div class="ap-card-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="ap-card-title">Favicon</span>
            </div>
            <div class="ap-card-body">
                <% if (favicon == true) { %>
                <div class="ap-current">
                    <img src="/assets/favicon.png?t=<%= Date.now() %>" alt="Current favicon">
                    <span style="flex:1">Custom favicon active</span>
                    <form action="/admin/settings/change/favicon" method="POST" style="margin:0">
                        <input type="hidden" name="type" value="none">
                        <button type="submit" class="btn btn-danger" style="padding:4px 10px;font-size:12px;">Remove</button>
                    </form>
                </div>
                <% } else { %>
                <div class="ap-current" style="background:rgba(139,92,246,0.06);border-color:rgba(139,92,246,0.15);color:rgba(167,139,250,0.7);">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Using default purple "O" favicon
                </div>
                <% } %>

                <form action="/admin/settings/change/favicon" method="POST" enctype="multipart/form-data" id="faviconForm">
                    <input type="hidden" name="type" value="image">
                    <label class="ap-upload-zone" id="faviconZone">
                        <input type="file" name="favicon" accept="image/png,image/x-icon,image/jpeg,image/webp" onchange="previewFile(this,'faviconPreview','faviconZone')">
                        <div class="ap-upload-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        </div>
                        <div class="ap-upload-text">Click to upload favicon</div>
                        <div class="ap-upload-hint">PNG, ICO, WEBP — shown in browser tab</div>
                    </label>
                    <div class="ap-preview" id="faviconPreview">
                        <img src="" alt="preview" id="faviconPreviewImg">
                        <span class="ap-preview-name" id="faviconPreviewName"></span>
                    </div>
                    <button type="submit" class="btn btn-primary" id="faviconSubmit" style="width:100%;justify-content:center;display:none;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Upload Favicon
                    </button>
                </form>
                <p class="ap-desc">Favicon shows in browser tab &amp; bookmarks. Recommended: 32×32px or 64×64px.</p>
            </div>
        </div>

        <!-- ── Registration ── -->
        <div class="ap-card">
            <div class="ap-card-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                <span class="ap-card-title">Registration</span>
            </div>
            <div class="ap-card-body">
                <div class="ap-toggle-row">
                    <div class="ap-toggle-info">
                        <div class="ap-toggle-label">Allow Registration</div>
                        <div class="ap-toggle-sub">New users can create accounts</div>
                    </div>
                    <form action="/admin/settings/toggle/register" method="POST">
                        <input type="hidden" name="register" value="<%= !settings.register %>">
                        <label class="ap-switch">
                            <input type="checkbox" <%= settings.register ? 'checked' : '' %> onchange="this.form.submit()">
                            <span class="ap-switch-track"></span>
                        </label>
                    </form>
                </div>
                <div class="ap-toggle-row">
                    <div class="ap-toggle-info">
                        <div class="ap-toggle-label">Force Email Verify</div>
                        <div class="ap-toggle-sub">Users must verify before logging in</div>
                    </div>
                    <form action="/admin/settings/toggle/force-verify" method="POST">
                        <input type="hidden" name="forceVerify" value="<%= !settings.forceVerify %>">
                        <label class="ap-switch">
                            <input type="checkbox" <%= settings.forceVerify ? 'checked' : '' %> onchange="this.form.submit()">
                            <span class="ap-switch-track"></span>
                        </label>
                    </form>
                </div>
            </div>
        </div>

    </div>
</main>

<%- include('../../components/head') %>

<script>
function previewFile(input, previewId, zoneId) {
    const file = input.files[0];
    if (!file) return;

    const preview = document.getElementById(previewId);
    const previewImg = document.getElementById(previewId + 'Img');
    const previewName = document.getElementById(previewId + 'Name');
    const submitBtn = document.getElementById(previewId.replace('Preview','Submit'));

    const reader = new FileReader();
    reader.onload = function(e) {
        previewImg.src = e.target.result;
        previewName.textContent = file.name + ' (' + (file.size / 1024).toFixed(1) + ' KB)';
        preview.classList.add('show');
        if (submitBtn) submitBtn.style.display = 'flex';
    };
    reader.readAsDataURL(file);

    // Dim the upload zone
    const zone = document.getElementById(zoneId);
    if (zone) zone.style.opacity = '0.5';
}
</script>
